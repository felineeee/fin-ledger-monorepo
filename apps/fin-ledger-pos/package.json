{
  "name": "fin-ledger-pos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/db/migrate_raw.ts",
    "db:generate": "kysely-codegen --out-file src/db/types.ts --dialect=postgres",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "docker compose down -v && docker compose up -d && sleep 2 && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@fin-ledger/database": "*",
    "@fin-ledger/guard": "*",
    "@fin-ledger/decorator": "*",
    "@fin-ledger/interceptor": "*",
    "@fin-ledger/config": "*",
    "@fin-ledger/logger": "*",
    "@nestjs/mapped-types": "*",
    "@fin-ledger/filter": "*"
  },
  "devDependencies": {
    "@fin-ledger/tsconfig": "*",
    "@faker-js/faker": "^10.5.0",
    "@types/redlock": "^4.0.8",
    "kysely-codegen": "^0.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
