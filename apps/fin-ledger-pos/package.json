{
  "name": "fin-ledger-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./src/test/jest-e2e.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:migrate": "tsx src/db/migrate_raw.ts",
    "db:generate": "kysely-codegen --out-file src/db/types.ts --dialect=postgres",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:fresh": "docker compose down -v && docker compose up -d && sleep 2 && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@fin-ledger/caches": "workspace:*",
    "@fin-ledger/configs": "workspace:*",
    "@fin-ledger/databases": "workspace:*",
    "@fin-ledger/decorators": "workspace:*",
    "@fin-ledger/filters": "workspace:*",
    "@fin-ledger/guards": "workspace:*",
    "@fin-ledger/interceptors": "workspace:*",
    "@fin-ledger/loggers": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "kysely": "0.29.4",
    "pg": "^8.11.0",
    "xendit-node": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@faker-js/faker": "^10.5.0",
    "@fin-ledger/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@ngrok/ngrok": "^1.7.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.0",
    "@types/redlock": "^4.0.8",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "kysely-codegen": "^0.11.0",
    "ngrok": "5.0.0-beta.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.24.0"
    }
  }
}
